.program pin_monitoring
.wrap_target
    pull block          ; OSRに 0xFFFFFFFF を取得
    mov Y, OSR          ; Yにセット
    
    wait 1 pin 0        ; ボール検知(HIGH)まで待機 

count_loop:
    mov ISR, null       ; ISRをリセット
    in pins, 1          ; 現在のピン状態を1bit取得
    mov X, ISR          ; Xにコピー
    
    jmp !X stop_count    ; ピンが1(HIGH)になったら計測終了
    jmp Y-- count_loop  ; 0(LOW)の間はカウントダウンしてループ

stop_count:
    mov ISR, Y          ; 残りカウントYをISRへ
    push noblock        ; 【重要】FIFOがいっぱいでも止まらないようにする
.wrap